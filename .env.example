# Backend API URL (Railway'da front-end servisinize bu değişkenleri ekleyin)
# Local: http://localhost:8080/api/v1
# Railway: https://YOUR-BACKEND-SERVICE.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket URL
# Local: ws://localhost:8080/ws
# Railway: wss://YOUR-BACKEND-SERVICE.up.railway.app/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# TURN Server Configuration (KRİTİK: Farklı ağlardaki kullanıcılar arası sesli/görüntülü arama için ZORUNLU)
# STUN sunucuları sadece aynı/basit ağlarda çalışır.
# Farklı ağ, operatör veya mobil kullananlar için TURN sunucusu şarttır - onsuz aramalar bağlanamaz.
#
# Ücretsiz test: https://www.metered.ca/tools/openrelay/
# Production için: Twilio TURN, Coturn (self-hosted), Xirsys önerilir
#
# Örnek değerler:
# NEXT_PUBLIC_TURN_URL=turn:openrelay.metered.ca:80
# NEXT_PUBLIC_TURN_USERNAME=openrelayproject
# NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
